{
  "name": "stocksplit-phase0",
  "private": true,
  "version": "0.1.0",
  "description": "StockSplit invite-only collaborative xStock portfolios on Solana",
  "scripts": {
    "test": "pnpm exec ts-mocha -p ./tsconfig.json -t 1000000 \"tests/**/*.ts\"",
    "test:local-demo": "node scripts/run-local-integration.mjs",
    "mock:devnet": "pnpm exec tsx scripts/create-mock-assets.ts",
    "demo-router:prepare": "pnpm exec tsx scripts/prepare-devnet-demo-router.ts",
    "demo:verify-upgrade": "pnpm exec tsx scripts/verify-devnet-upgrade.ts",
    "verify:program-identity": "node scripts/verify-program-identity.mjs",
    "frontend:build": "node frontend/build.mjs",
    "frontend:dev": "node frontend/dev-server.mjs",
    "faucet:devnet": "node demo-faucet/server.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bs58": "4.0.1"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.2",
    "chai": "4.5.0",
    "ts-mocha": "11.1.0",
    "ts-node": "10.9.2",
    "tsx": "4.20.3",
    "typescript": "5.9.2"
  }
}
